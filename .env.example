# ─── Instagram MCP — Environment Configuration ───────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Browser Settings ──────────────────────────────────────────────────────────
# Options: chrome | brave
BROWSER_TYPE=chrome

# Set to true to run browser in background (no window)
HEADLESS=false

# ── Timeouts (milliseconds) ───────────────────────────────────────────────────
DEFAULT_TIMEOUT_MS=30000
NAVIGATION_TIMEOUT_MS=60000

# ── Retry Settings ────────────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_DELAY_S=2.0

# ── MCP Server ────────────────────────────────────────────────────────────────
MCP_SERVER_NAME=instagram-mcp
MCP_HOST=127.0.0.1
MCP_PORT=8765

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
